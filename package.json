{
  "name": "@yielded/effect-tsrs",
  "version": "0.2.2",
  "description": "Native Effect diagnostics for TypeScript, powered by tsrs",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yielded-dev/effect-tsrs.git"
  },
  "homepage": "https://github.com/yielded-dev/effect-tsrs#readme",
  "bugs": "https://github.com/yielded-dev/effect-tsrs/issues",
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "effect-tsrs": "bin/effect-tsrs.js"
  },
  "files": [
    "bin/",
    "oxlint-presets/",
    "oxlint-schema.json",
    "LICENSE",
    "THIRD-PARTY-NOTICES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare:oxlint": "node scripts/prepare-oxlint.mjs",
    "setup": "node scripts/setup-tsrs.mjs",
    "build": "node scripts/cargo.mjs build --locked",
    "build:release": "node scripts/cargo.mjs build --release --locked",
    "check": "node scripts/cargo.mjs fmt --check && node scripts/cargo.mjs clippy --all-targets --locked -- -D warnings",
    "test": "node scripts/cargo.mjs test --locked && node --test scripts/oxlint.test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "fixtures:install": "npm ci --ignore-scripts --legacy-peer-deps --prefix fixtures/all/deps/v3 && npm ci --ignore-scripts --legacy-peer-deps --prefix fixtures/all/deps/v4",
    "bench": "node scripts/bench.mjs",
    "bench:diagnostics": "node scripts/bench-diagnostics.mjs",
    "bench:project": "node scripts/bench-project.mjs",
    "package:release": "node scripts/package-release.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:oxlint": "node scripts/verify-oxlint.mjs",
    "bench:oxlint": "node scripts/bench-oxlint.mjs",
    "verify:oxlint:all": "node scripts/verify-oxlint-all.mjs",
    "verify:project": "node scripts/verify-project.mjs"
  },
  "optionalDependencies": {
    "@yielded/effect-tsrs-darwin-arm64": "0.2.2",
    "@yielded/effect-tsrs-darwin-x64": "0.2.2",
    "@yielded/effect-tsrs-linux-arm64": "0.2.2",
    "@yielded/effect-tsrs-linux-x64": "0.2.2",
    "@yielded/effect-tsrs-win32-x64": "0.2.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.56.1",
    "effect": "4.1.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.1.0-beta"
  },
  "exports": {
    "./package.json": "./package.json",
    "./oxlint-presets": {
      "types": "./oxlint-presets/index.d.ts",
      "default": "./oxlint-presets/index.js"
    },
    "./oxlint-presets/*.json": "./oxlint-presets/*.json",
    "./oxlint-schema.json": "./oxlint-schema.json"
  }
}
